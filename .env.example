# Backend (serverless function) — set these in your host's env, not in the bundle.
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the extraction model. Defaults to claude-haiku-4-5 (cheapest
# model with vision + structured outputs). Bump to claude-sonnet-4-6 or
# claude-opus-4-8 if accuracy needs it.
# EXTRACT_MODEL=claude-haiku-4-5

# Frontend — develop the UI without calling the real API.
# Set to true to use built-in mock tasks instead of /api/extract.
VITE_USE_MOCK=false
