# Backend (serverless function) — set these in your host's env, not in the bundle.
GEMINI_API_KEY=AIza...
# Optional: override the extraction model. Defaults to gemini-3.5-flash, which
# has a (rate-limited) free tier — good for testing on a budget. Bump to a
# paid/Pro model later if accuracy on real screenshots needs it.
# EXTRACT_MODEL=gemini-3.5-flash

# Frontend — Supabase project (Settings > API in the Supabase dashboard).
# Use the PUBLISHABLE key (sb_publishable_...), never the secret key — this
# ships into the public JS bundle. Row Level Security is what keeps data safe.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Frontend — develop the UI without calling the real API.
# Set to true to use built-in mock tasks instead of /api/extract.
VITE_USE_MOCK=false

# ── Google Calendar sync (v4.0) — SERVER-SIDE ONLY (no VITE_ prefix) ──────────
# These are read by the /api/google/* serverless functions and must NEVER be
# exposed to the browser. The refresh token + client secret stay on the server.

# Google OAuth client (the SAME client configured in Supabase's Google provider).
# Google Cloud Console > APIs & Services > Credentials. The OAuth consent screen
# must include the .../auth/calendar.events scope. For Gmail extraction (v4.1)
# also enable the Gmail API and add the .../auth/gmail.readonly scope (a Google
# RESTRICTED scope — see docs/calendar-sync-setup.md). No extra env vars needed.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Supabase service-role credentials (Settings > API). The service-role key
# bypasses RLS so the functions can read the service-role-only credential tables.
# Keep it secret — it is a full-access key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Shared secret guarding the /api/google/sync-all cron endpoint. Vercel cron
# sends it as `Authorization: Bearer <CRON_SECRET>`. Use any long random string.
CRON_SECRET=...
